[{"metadata": [{"name_uz": "Birinchi chop etilgan sana", "name_ru": "\u0414\u0430\u0442\u0430 \u043f\u0435\u0440\u0432\u043e\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438", "name_en": "Date of first publication", "name_uzc": "\u0411\u0438\u0440\u0438\u043d\u0447\u0438 \u0447\u043e\u043f \u044d\u0442\u0438\u043b\u0433\u0430\u043d \u0441\u0430\u043d\u0430", "value_uz": "2022-07-07", "value_ru": "2022-07-07", "value_en": "2022-07-07", "value_uzc": "2022-07-07"}, {"name_uz": "So'nggi o'zgartirilgan sana", "name_ru": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f", "name_en": "Last modified date", "name_uzc": "\u0421\u045e\u043d\u0433\u0433\u0438 \u045e\u0437\u0433\u0430\u0440\u0442\u0438\u0440\u0438\u043b\u0433\u0430\u043d \u0441\u0430\u043d\u0430", "value_uz": "2026-09-26", "value_ru": "2026-09-26", "value_en": "2026-09-26", "value_uzc": "2026-09-26"}, {"name_uz": "Ma'lumotlar to'plami identifikatsiya raqami (kodi)", "name_ru": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 (\u043a\u043e\u0434)", "name_en": "Indicator identification number (code)", "name_uzc": "\u041c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u0442\u045e\u043f\u043b\u0430\u043c\u0438 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0440\u0430\u049b\u0430\u043c\u0438 (\u043a\u043e\u0434\u0438)", "value_uz": "1.08.02.0023", "value_ru": "1.08.02.0023", "value_en": "1.08.02.0023", "value_uzc": "1.08.02.0023"}, {"name_uz": "Ma'lumotlar to'plami nomi", "name_ru": "\u0418\u043c\u044f \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430", "name_en": "Indicator name", "name_uzc": "\u041c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u0442\u045e\u043f\u043b\u0430\u043c\u0438 \u04