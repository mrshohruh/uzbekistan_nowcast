1\u043b\u0438\u043a\u0438 \u0423\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d (\u0422\u041d\u0412\u042d\u0414)", "value_en": "Commodity nomenclature foreign economic activities Republic of Uzbekistan", "value_uzc": "\u040e\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u043e\u043d \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0441\u0438 \u0442\u0430\u0448\u049b\u0438 \u0438\u049b\u0442\u0438\u0441\u043e\u0434\u0438\u0439 \u0444\u0430\u043e\u043b\u0438\u044f\u0442\u043d\u0438\u043d\u0433 \u0442\u043e\u0432\u0430\u0440\u043b\u0430\u0440 \u043d\u043e\u043c\u0435\u043d\u043a\u043b\u0430\u0442\u0443\u0440\u0430\u0441\u0438 (\u0422\u0418\u0424 \u0422\u041d)"}, {"name_uz": "Hisoblash metodikasi", "name_ru": "\u041c\u0435\u0442\u043e\u0434\u044b \u0440\u0430\u0441\u0447\u0435\u0442\u0430", "name_en": "Calculation methodology", "name_uzc": "\u04b2\u0438\u0441\u043e\u0431\u043b\u0430\u0448 \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0430\u0441\u0438", "value_uz": "https://lib.stat.uz/uz/features/tashqi-iqtisodiy-faoliyat-va-savdo/625-barcha-sotish-tarmoqlari-bo-yicha-chakana-savdo-tovar-aylanmasi-va-tovar-zahiralarini-statistik-hisoblash-bo-yicha-uslubiy-qo-llanma-49", "value_ru": "https://lib.stat.uz/ru/features-3/vneshneekonomicheskaya-deyatelnost-i-torgovlya/626-09032022", "value_en": "https://lib.stat.uz/ru/features-3/vneshneekonomicheskaya-deyatelnost-i-torgovlya/626-09032022", "value_uzc": "https://lib.stat.uz/uz/features/tashqi-iqtisodiy-faoliyat-va-savdo/625-barcha-sotish-tarmoqlari-bo-yicha-chakana-savdo-tovar-aylanmasi-va-tovar-zahiralarini-statistik-hisoblash-bo-yicha-uslubiy-qo-llanma-49"}, {"name_uz": "Rasmiy statistika tayyorlovchi", "name_ru": "\u0421\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044c \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438", "name_en": "Official statistics preparer", "name_uzc": "\u0420\u0430\u0441\u043c\u0438\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0442\u0430\u0439\u0451\u0440\u043b\u043e\u0432\u0447\u0438", "value_uz": "O\u2018zbekiston Respublikasi Milliy statistika qo\u2018mitasi", "value_ru": "\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043c\u0438\u0442\u0435\u0442 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u0423\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d \u043f\u043e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0435", "value_en": "National Statistics Committee of the Republic of Uzbekistan", "value_uzc": "\u040e\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u043e\u043d \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0441\u0438 \u041c\u0438\u043b\u043b\u0438\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u049b\u045e\u043c\u0438\u0442\u0430\u0441\u0438"}, {"name_uz": "Mas'ul boshqarma nomi", "name_ru": "\u041e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435", "name_en": "Name of department", "name_uzc": "\u041c\u0430\u0441\u044a\u0443\u043b \u0431\u043e\u0448\u049b\u0430\u0440\u043c\u0430 \u043d\u043e\u043c\u0438", "value_uz": "Tashqi iqtisodiy faoliyat va savdo statistikasi boshqarmasi", "value_ru": "\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438 \u0432\u043d\u0435\u0448\u043d\u0435\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0438", "value_en": "Department of Foreign Economic Activity and Trade Statistics", "value_uzc": "\u0422\u0430\u0448\u049b\u0438 \u0438\u049b\u0442\u0438\u0441\u043e\u0434\u0438\u0439 \u0444\u0430\u043e\u043b\u0438\u044f\u0442 \u0432\u0430 \u0441\u0430\u0432\u0434\u043e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430\u0441\u0438 \u0431\u043e\u0448\u049b\u0430\u0440\u043c\u0430\u0441\u0438"}, {"name_uz": "Mas'ul hodim FIO", "name_ru": "O\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u0424\u0418\u041e", "name_en": "Responsible officer name", "name_uzc": "\u041c\u0430\u0441\u044a\u0443\u043b \u04b3\u043e\u0434\u0438\u043c \u0424\u0418\u041e", "value_uz": "Sh. Jurayev", "value_ru": "\u0428. \u0416\u0443\u0440\u0430\u0435\u0432", "value_en": "Sh. Jurayev", "value_uzc": "\u0428. \u0416\u0443\u0440\u0430\u0435\u0432"}, {"name_uz": "Aloqa uchun", "name_ru": "\u0414\u043b\u044f \u043e\u0431\u0449\u0435\u043d\u0438\u044f", "name_en": "For communication", "name_uzc": "\u0410\u043b\u043e\u049b\u0430 \u0443\u0447\u0443\u043d", "value_uz": "99871 202 80 44", "value_ru": "99871 202 80 44", "value_en": "99871 202 80 44", "value_uzc": "99871 202 80 44"}, {"name_uz": "Telefon raqami", "name_ru": "\u041d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430", "name_en": "Phone number", "name_uzc": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u0440\u0430\u049b\u0430\u043c\u0438", "value_uz": "99871 202 80 44", "value_ru": "99871 202 80 44", "value_en": "99871 202 80 44", "value_uzc": "99871 202 80 44"}, {"name_uz": "Elektron pochta", "name_ru": "\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0430\u044f \u043f\u043e\u0447\u0442\u0430", "name_en": "Email", "name_uzc": "\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d \u043f\u043e\u0447\u0442\u0430", "value_uz": "trade@stat.uz", "value_ru": "trade@stat.uz", "value_en": "trade@stat.uz", "value_uzc": "trade@stat.uz"}, {"name_uz": "Birlamchi ma'lumot manbasi", "name_ru": "\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438", "name_en": "Primary source of information", "name_uzc": "\u0411\u0438\u0440\u043b\u0430\u043c\u0447\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442 \u043c\u0430\u043d\u0431\u0430\u0441\u0438", "value_uz": "Davlat bojxona qo\u2018mitasi tomonidan bojxona yuk deklaratsiyalari ma\u2019lumotlari asosida shakllantirilgan (oylik) ma\u2019lumotlar ba\u2019zasi, Markaziy bank tomonidan eksport qilingan qimmatbaho metallar to\u2018g\u2018risidagi (oylik) ma\u2019lumotlar  Davlat statistika hisobotlari asosida eksport-import  xizmatlari hajmi (oylik) 12-korxona oylik, 1- kb TIF yillik, Davlat statistika kuzatuvlari asosida shakllantirilgan  turizm xizmatlarning eksport-import hajmlari (turistlar o\u2018rtasida har ikki yilda bir marta tanlanma kuzatuv (so\u2018rovnoma) o\u2018tkaziladi).  Jismoniy shaxslar tomonidan deklaratsiya to\u2018ldirmasdan olib kiralayotgan va olib chiqilayotgan tovarlar (meva-sabzavotlardan tashqari) bo\u2018yicha statistik kuzatuv ma\u2019lumotlari (bir yilda ikki marta kuzatilib, so\u2018ng har oy baholanib boriladi)", "value_ru": "\u0411\u0430\u0437\u0430 \u0434\u0430\u043d\u043d\u044b\u0445 (\u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e), \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0442\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u044b\u043c \u043a\u043e\u043c\u0438\u0442\u0435\u0442\u043e\u043c \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0434\u0430\u043d\u043d\u044b\u0445 \u0442\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u044b\u0445 \u0433\u0440\u0443\u0437\u043e\u0432\u044b\u0445 \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u0439, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0430\u044f (\u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e) \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043e \u0434\u0440\u0430\u0433\u043e\u0446\u0435\u043d\u043d\u044b\u0445 \u043c\u0435\u0442\u0430\u043b\u043b\u0430\u0445, \u0432\u044b\u0432\u043e\u0437\u0438\u043c\u044b\u0445 \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0431\u0430\u043d\u043a\u043e\u043c, \u042d\u043a\u0441\u043f\u043e\u0440\u0442-\u0438\u043c\u043f\u043e\u0440\u0442 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043e\u0442\u0447\u0435\u0442\u043d\u043e\u0441\u0442\u0438 \u043e\u0431\u044a\u0435\u043c \u0443\u0441\u043b\u0443\u0433 (\u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e) 12-korxona \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e, 1-kb TIF \u0435\u0436\u0435\u0433\u043e\u0434\u043d\u043e, \u0424\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0439 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u043d\u043e-\u0438\u043c\u043f\u043e\u0440\u0442\u043d\u044b\u0435 \u043e\u0431\u044a\u0435\u043c\u044b \u0442\u0443\u0440\u0438\u0441\u0442\u0441\u043a\u0438\u0445 \u0443\u0441\u043b\u0443\u0433 (\u0432\u044b\u0431\u043e\u0440\u043e\u0447\u043d\u043e\u0435 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 (\u0430\u043d\u043a\u0435\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435) \u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u0438 \u0442\u0443\u0440\u0438\u0441\u0442\u043e\u0432 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0432 \u0434\u0432\u0430 \u0433\u043e\u0434\u0430). \u0414\u0430\u043d\u043d\u044b\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u044f \u0437\u0430 \u0432\u0432\u043e\u0437\u0438\u043c\u044b\u043c\u0438 \u0438 \u0432\u044b\u0432\u043e\u0437\u0438\u043c\u044b\u043c\u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438 \u043b\u0438\u0446\u0430\u043c\u0438 \u0442\u043e\u0432\u0430\u0440\u0430\u043c\u0438 (\u043a\u0440\u043e\u043c\u0435 \u0444\u0440\u0443\u043a\u0442\u043e\u0432 \u0438 \u043e\u0432\u043e\u0449\u0435\u0439) \u0431\u0435\u0437 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u0438 (\u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0432 \u0433\u043e\u0434, \u0430 \u0437\u0430\u0442\u0435\u043c \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u043e", "value_en": "Database (monthly), formed by the State Customs Committee on the basis of customs cargo declarations, containing (monthly) information on precious metals exported by the Central Bank, Export-import based on state statistical reporting volume of services (monthly) 12-korxona monthly, 1-kb TIF annually, The export-import volumes of tourist services are formed on the basis of state statistical observations (selective observation (questionnaire) is carried out among tourists once every two years). Statistical observation data on goods imported and exported by individuals (except fruits and vegetables) without filling out a declaration (tracked twice a year, and then evaluated monthly)", "value_uzc": "\u0414\u0430\u0432\u043b\u0430\u0442 \u0431\u043e\u0436\u0445\u043e\u043d\u0430 \u049b\u045e\u043c\u0438\u0442\u0430\u0441\u0438 \u0442\u043e\u043c\u043e\u043d\u0438\u0434\u0430\u043d \u0431\u043e\u0436\u0445\u043e\u043d\u0430 \u044e\u043a \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u044f\u043b\u0430\u0440\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440\u0438 \u0430\u0441\u043e\u0441\u0438\u0434\u0430 \u0448\u0430\u043a\u043b\u043b\u0430\u043d\u0442\u0438\u0440\u0438\u043b\u0433\u0430\u043d (\u043e\u0439\u043b\u0438\u043a) \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u0431\u0430\u044a\u0437\u0430\u0441\u0438, \u041c\u0430\u0440\u043a\u0430\u0437\u0438\u0439 \u0431\u0430\u043d\u043a \u0442\u043e\u043c\u043e\u043d\u0438\u0434\u0430\u043d \u044d\u043a\u0441\u043f\u043e\u0440\u0442 \u049b\u0438\u043b\u0438\u043d\u0433\u0430\u043d \u049b\u0438\u043c\u043c\u0430\u0442\u0431\u0430\u04b3\u043e \u043c\u0435\u0442\u0430\u043b\u043b\u0430\u0440 \u0442\u045e\u0493\u0440\u0438\u0441\u0438\u0434\u0430\u0433\u0438 (\u043e\u0439\u043b\u0438\u043a) \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440  \u0414\u0430\u0432\u043b\u0430\u0442 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u04b3\u0438\u0441\u043e\u0431\u043e\u0442\u043b\u0430\u0440\u0438 \u0430\u0441\u043e\u0441\u0438\u0434\u0430 \u044d\u043a\u0441\u043f\u043e\u0440\u0442-\u0438\u043c\u043f\u043e\u0440\u0442  \u0445\u0438\u0437\u043c\u0430\u0442\u043b\u0430\u0440\u0438 \u04b3\u0430\u0436\u043c\u0438 (\u043e\u0439\u043b\u0438\u043a) 12-\u043a\u043e\u0440\u0445\u043e\u043d\u0430 \u043e\u0439\u043b\u0438\u043a, 1- \u043a\u0431 \u0422\u0418\u0424 \u0439\u0438\u043b\u043b\u0438\u043a, \u0414\u0430\u0432\u043b\u0430\u0442 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u043a\u0443\u0437\u0430\u0442\u0443\u0432\u043b\u0430\u0440\u0438 \u0430\u0441\u043e\u0441\u0438\u0434\u0430 \u0448\u0430\u043a\u043b\u043b\u0430\u043d\u0442\u0438\u0440\u0438\u043b\u0433\u0430\u043d  \u0442\u0443\u0440\u0438\u0437\u043c \u0445\u0438\u0437\u043c\u0430\u0442\u043b\u0430\u0440\u043d\u0438\u043d\u0433 \u044d\u043a\u0441\u043f\u043e\u0440\u0442-\u0438\u043c\u043f\u043e\u0440\u0442 \u04b3\u0430\u0436\u043c\u043b\u0430\u0440\u0438 (\u0442\u0443\u0440\u0438\u0441\u0442\u043b\u0430\u0440 \u045e\u0440\u0442\u0430\u0441\u0438\u0434\u0430 \u04b3\u0430\u0440 \u0438\u043a\u043a\u0438 \u0439\u0438\u043b\u0434\u0430 \u0431\u0438\u0440 \u043c\u0430\u0440\u0442\u0430 \u0442\u0430\u043d\u043b\u0430\u043d\u043c\u0430 \u043a\u0443\u0437\u0430\u0442\u0443\u0432 (\u0441\u045e\u0440\u043e\u0432\u043d\u043e\u043c\u0430) \u045e\u0442\u043a\u0430\u0437\u0438\u043b\u0430\u0434\u0438).  \u0416\u0438\u0441\u043c\u043e\u043d\u0438\u0439 \u0448\u0430\u0445\u0441\u043b\u0430\u0440 \u0442\u043e\u043c\u043e\u043d\u0438\u0434\u0430\u043d \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u044f \u0442\u045e\u043b\u0434\u0438\u0440\u043c\u0430\u0441\u0434\u0430\u043d \u043e\u043b\u0438\u0431 \u043a\u0438\u0440\u0430\u043b\u0430\u0451\u0442\u0433\u0430\u043d \u0432\u0430 \u043e\u043b\u0438\u0431 \u0447\u0438\u049b\u0438\u043b\u0430\u0451\u0442\u0433\u0430\u043d \u0442\u043e\u0432\u0430\u0440\u043b\u0430\u0440 (\u043c\u0435\u0432\u0430-\u0441\u0430\u0431\u0437\u0430\u0432\u043e\u0442\u043b\u0430\u0440\u0434\u0430\u043d \u0442\u0430\u0448\u049b\u0430\u0440\u0438) \u0431\u045e\u0439\u0438\u0447\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a \u043a\u0443\u0437\u0430\u0442\u0443\u0432 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440\u0438 (\u0431\u0438\u0440 \u0439\u0438\u043b\u0434\u0430 \u0438\u043a\u043a\u0438 \u043c\u0430\u0440\u0442\u0430 \u043a\u0443\u0437\u0430\u0442\u0438\u043b\u0438\u0431, \u0441\u045e\u043d\u0433 \u04b3\u0430\u0440 \u043e\u0439 \u0431\u0430\u04b3\u043e\u043b\u0430\u043d\u0438\u0431 \u0431\u043e\u0440\u0438\u043b\u0430\u0434\u0438)"}, {"name_uz": "Izoh", "name_ru": "\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435", "name_en": "Note", "name_uzc": "\u0418\u0437\u043e\u04b3", "value_uz": "oylar kesimida", "value_ru": "\u0412 \u0440\u0430\u0437\u0440\u0435\u0437\u0435 \u043c\u0435\u0441\u044f\u0446\u0435\u0432", "value_en": "By months", "value_uzc": "\u043e\u0439\u043b\u0430\u0440 \u043a\u0435\u0441\u0438\u043c\u0438\u0434\u0430"}, {"name_uz": "Hisoblash metodikasi (qisqacha)", "name_ru": "\u041c\u0435\u0442\u043e\u0434\u044b \u0440\u0430\u0441\u0447\u0435\u0442\u0430 (\u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u043e)", "name_en": "Calculation methodology (briefly)", "name_uzc": "\u04b2\u0438\u0441\u043e\u0431\u043b\u0430\u0448 \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0430\u0441\u0438 (\u049b\u0438\u0441\u049b\u0430\u0447\u0430)", "value_uz": "Tovarlarning tashqi savdo statistikasi O\u02bbzbekiston Respublikasi bojxona hududiga olib kirish (import) yoki O\u02bbzbekiston Respublikasi bojxona hududidan olib chiqish (eksport) natijasida mamlakat material resurslari zaxiralariga qo\u02bbshiladigan yoki ulardan ayirib tashlanadigan tovarlar hisobini tashqi savdo umumiy hisob tizimi asosida yuritadi.", "value_ru": "\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0432\u043d\u0435\u0448\u043d\u0435\u0439 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0438 \u0442\u043e\u0432\u0430\u0440\u0430\u043c\u0438 \u0432\u0435\u0434\u0435\u0442 \u0443\u0447\u0435\u0442 \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043a \u0437\u0430\u043f\u0430\u0441\u0430\u043c \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0441\u0442\u0440\u0430\u043d\u044b \u0438\u043b\u0438 \u0432\u044b\u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f \u0438\u0437 \u043d\u0438\u0445 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0438\u0445 \u0432\u0432\u043e\u0437\u0430 (\u0438\u043c\u043f\u043e\u0440\u0442\u0430) \u043d\u0430 \u0442\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u0443\u044e \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u044e \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u0423\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d \u0438\u043b\u0438 \u0438\u0445 \u0432\u044b\u0432\u043e\u0437\u0430 (\u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0430) \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0442\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u0423\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0438 \u043e\u0431\u0449\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0443\u0447\u0435\u0442\u0430 \u0432\u043d\u0435\u0448\u043d\u0435\u0439 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0438.", "value_en": "5", "value_uzc": "\u0422\u043e\u0432\u0430\u0440\u043b\u0430\u0440\u043d\u0438\u043d\u0433 \u0442\u0430\u0448\u049b\u0438 \u0441\u0430\u0432\u0434\u043e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430\u0441\u0438 \u040e\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u043e\u043d \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0441\u0438 \u0431\u043e\u0436\u0445\u043e\u043d\u0430 \u04b3\u0443\u0434\u0443\u0434\u0438\u0433\u0430 \u043e\u043b\u0438\u0431 \u043a\u0438\u0440\u0438\u0448 (\u0438\u043c\u043f\u043e\u0440\u0442) \u0451\u043a\u0438 \u040e\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u043e\u043d \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0441\u0438 \u0431\u043e\u0436\u0445\u043e\u043d\u0430 \u04b3\u0443\u0434\u0443\u0434\u0438\u0434\u0430\u043d \u043e\u043b\u0438\u0431 \u0447\u0438\u049b\u0438\u0448 (\u044d\u043a\u0441\u043f\u043e\u0440\u0442) \u043d\u0430\u0442\u0438\u0436\u0430\u0441\u0438\u0434\u0430 \u043c\u0430\u043c\u043b\u0430\u043a\u0430\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u0440\u0435\u0441\u0443\u0440\u0441\u043b\u0430\u0440\u0438 \u0437\u0430\u0445\u0438\u0440\u0430\u043b\u0430\u0440\u0438\u0433\u0430 \u049b\u045e\u0448\u0438\u043b\u0430\u0434\u0438\u0433\u0430\u043d \u0451\u043a\u0438 \u0443\u043b\u0430\u0440\u0434\u0430\u043d \u0430\u0439\u0438\u0440\u0438\u0431 \u0442\u0430\u0448\u043b\u0430\u043d\u0430\u0434\u0438\u0433\u0430\u043d \u0442\u043e\u0432\u0430\u0440\u043b\u0430\u0440 \u04b3\u0438\u0441\u043e\u0431\u0438\u043d\u0438 \u0442\u0430\u0448\u049b\u0438 \u0441\u0430\u0432\u0434\u043e \u0443\u043c\u0443\u043c\u0438\u0439 \u04b3\u0438\u0441\u043e\u0431 \u0442\u0438\u0437\u0438\u043c\u0438 \u0430\u0441\u043e\u0441\u0438\u0434\u0430 \u044e\u0440\u0438\u0442\u0430\u0434\u0438."}], "data": [{"Code": "1700", "Klassifikator": "O\u2018zbekiston Respublikasi", "Klassifikator_ru": "\u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430 \u0423\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d", "Klassifikator_en": "Republic of Uzbekistan", "Klassifikator_uzc": "\u040e\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u043e\u043d \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0441\u0438", "2021-M01": 694.7, "2021-M02": 1499.2, "2021-M03": 2418.6, "2021-M04": 3499.7, "2021-M05": 5745.5, "2021-M06": 7064.1, "2021-M07": 8160.0, "2021-M08": 9303.4, "2021-M09": 10357.2, "2021-M10": 12506.4, "2021-M11": 15509.2, "2021-M12": 16662.8, "2022-M01": 1435.0, "2022-M02": 4150.1, "2022-M03": 5843.7, "2022-M04": 7211.0, "2022-M05": 8468.1, "2022-M06": 9870.4, "2022-M07": 11412.7, "2022-M08": 12857.5, "2022-M09": 14369.2, "2022-M10": 15852.0, "2022-M11": 17768.3, "2022-M12": 19732.6, "2023-M01": 2108.9, "2023-M02": 3195.4, "2023-M03": 5804.3, "2023-M04": 7789.1, "2023-M05": 10657.3, "2023-M06": 12310.9, "2023-M07": 14954.4, "2023-M08": 16434.6, "2023-M09": 17739.4, "2023-M10": 20470.2, "2023-M11": 23204.3, "2023-M12": 24869.5, "2024-M01": 1148.4, "2024-M02": 3635.2, "2024-M03": 6515.4, "2024-M04": 8792.1, "2024-M05": 11304.8, "2024-M06": 13076.4, "2024-M07": 14912.0, "2024-M08": 17503.3, "2024-M09": 20013.3, "2024-M10": 22692.9, "2024-M11": 24488.7, "2024-M12": 27270.1, "2025-M01": 1336.2, "2025-M02": 4627.9, "2025-M03": 8213.6, "2025-M04": 11982.4, "2025-M05": 14952.7, "2025-M06": 17401.0, "2025-M07": 20681.2, "2025-M08": 23661.7, "2025-M09": 26683.6, "2025-M10": 29005.9, "2025-M11": 30894