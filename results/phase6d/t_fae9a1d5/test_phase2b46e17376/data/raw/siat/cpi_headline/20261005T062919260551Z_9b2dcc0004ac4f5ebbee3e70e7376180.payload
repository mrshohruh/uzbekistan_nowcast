[{"metadata": [{"name_uz": "Birinchi chop etilgan sana", "name_ru": "\u0414\u0430\u0442\u0430 \u043f\u0435\u0440\u0432\u043e\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438", "name_en": "Date of first publication", "name_uzc": "\u0411\u0438\u0440\u0438\u043d\u0447\u0438 \u0447\u043e\u043f \u044d\u0442\u0438\u043b\u0433\u0430\u043d \u0441\u0430\u043d\u0430", "value_uz": "2022-08-06", "value_ru": "2022-08-06", "value_en": "2022-08-06", "value_uzc": "2022-08-06"}, {"name_uz": "So'nggi o'zgartirilgan sana", "name_ru": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f", "name_en": "Last modified date", "name_uzc": "\u0421\u045e\u043d\u0433\u0433\u0438 \u045e\u0437\u0433\u0430\u0440\u0442\u0438\u0440\u0438\u043b\u0433\u0430\u043d \u0441\u0430\u043d\u0430", "value_uz": "2026-09-05", "value_ru": "2026-09-05", "value_en": "2026-09-05", "value_uzc": "2026-09-05"}, {"name_uz": "Ma'lumotlar to'plami identifikatsiya raqami (kodi)", "name_ru": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 (\u043a\u043e\u0434)", "name_en": "Indicator identification number (code)", "name_uzc": "\u041c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u0442\u045e\u043f\u043b\u0430\u043c\u0438 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0440\u0430\u049b\u0430\u043c\u0438 (\u043a\u043e\u0434\u0438)", "value_uz": "1.11.01.0002", "value_ru": "1.11.01.0002", "value_en": "1.11.01.0002", "value_uzc": "1.11.01.0002"}, {"name_uz": "Birinchi chop etilgan sana", "name_ru": "\u0414\u0430\u0442\u0430 \u043f\u0435\u0440\u0432\u043e\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438", "name_en": "Date of first publication", "name_uzc": null, "value_uz": "2022-08-06", "value_ru": "2022-08-06", "value_en": "2022-08-06", "value_uzc": null}, {"name_uz": "So'nggi o'zgartirilgan sana", "name_ru": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f", "name_en": "Last modified date", "name_uzc": null, "value_uz": "2024-01-18", "value_ru": "2024-01-18", "value_en": "2024-01-18", "value_uzc": null}, {"name_uz": "Ma'lumotlar to'plami identifikatsiya raqami (kodi)", "name_ru": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 (\u043a\u043e\u0434)", "name_en": "Indicator identification number (code)", "name_uzc": null, "value_uz": "1.11.01.0002", "value_ru": "1.11.01.0002", "value_en": "1.11.01.0002", "value_uzc": null}, {"name_uz": "Ma\u2019lumotlar to\u2018plami nomi", "name_ru": "\u0418\u043c\u044f \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430", "name_en": "Indicator name", "name_uzc": "\u041c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u0442\u045e\u043f\u043b\u0430\u043c\u0438 \u043d\u043e\u043c\u0438", "value_uz": "Iste\u2019mol narxlari indeksi dinamikasi, MIIT-2018 bo\u2018yicha (o\u2018tgan oyga nisbatan)", "value_ru": "\u0414\u0438\u043d\u0430\u043c\u0438\u043a\u0430 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445 \u0446\u0435\u043d \u043f\u043e \u041a\u0418\u041f\u0426-2018 (\u043a \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u043c\u0443 \u043c\u0435\u0441\u044f\u0446\u0443)", "value_en": "Dynamics of the consumer price index according to COICOP-2018 (compared to last month)", "value_uzc": "\u0418\u0441\u0442\u0435\u044a\u043c\u043e\u043b \u043d\u0430\u0440\u0445\u043b\u0430\u0440\u0438 \u0438\u043d\u0434\u0435\u043a\u0441\u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u043a\u0430\u0441\u0438, \u041c\u0418\u0418\u0422-2018 \u0431\u045e\u0439\u0438\u0447\u0430 (\u045e\u0442\u0433\u0430\u043d \u043e\u0439\u0433\u0430 \u043d\u0438\u0441\u0431\u0430\u0442\u0430\u043d)"}, {"name_uz": "Davriyligi", "name_ru": "\u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u043e\u0441\u0442\u044c", "name_en": "Periodicity", "name_uzc": "\u0414\u0430\u0432\u0440\u0438\u0439\u043b\u0438\u0433\u0438", "value_uz": "oylik", "value_ru": "\u0435\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0439", "value_en": "monthly", "value_uzc": "\u043e\u0439\u043b\u0438\u043a"}, {"name_uz": "O\u2018lchov birligi", "name_ru": "\u0415\u0434\u0438\u043d\u0438\u0446\u0430 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f", "name_en": "Unit of measurement", "name_uzc": "\u040e\u043b\u0447\u043e\u0432 \u0431\u0438\u0440\u043b\u0438\u0433\u0438", "value_uz": "Foiz", "value_ru": "\u041f\u0440\u043e\u0446\u0435\u043d\u0442", "value_en": "Percent", "value_uzc": "\u0424\u043e\u0438\u0437"}, {"name_uz": "Klassifikatorlar", "name_ru": "\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440", "name_en": "Classifiers", "name_uzc": "\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u043b\u0430\u0440", "value_uz": "Maqsadlar bo\u2018yicha individual iste\u2019mol tasniflagichi - 2018 (MIIT-2018)", "value_ru": "\u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043f\u043e \u0446\u0435\u043b\u044f\u043c - 2018 (\u041a\u0418\u041f\u0426-2018)", "value_en": "Classification of individual consumption by purpose - 2018 (COICOP-2018)", "value_uzc": "\u041c\u0430\u049b\u0441\u0430\u0434\u043b\u0430\u0440 \u0431\u045e\u0439\u0438\u0447\u0430 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b \u0438\u0441\u0442\u0435\u044a\u043c\u043e\u043b \u0442\u0430\u0441\u043d\u0438\u0444\u043b\u0430\u0433\u0438\u0447\u0438 - 2018 (\u041c\u0418\u0418\u0422-2018)"}, {"name_uz": "Hisoblash metodikasi", "name_ru": "\u041c\u0435\u0442\u043e\u0434\u044b \u0440\u0430\u0441\u0447\u0435\u0442\u0430", "name_en": "Calculation methodology", "name_uzc": "\u04b2\u0438\u0441\u043e\u0431\u043b\u0430\u0448 \u043c\u0435\u0442\u043e\u0434\u0438\u043a\u0430\u0441\u0438", "value_uz": "https://lib.stat.uz/uz/features/narxlar/653-tovarlar-va-xizmatlarning-iste-mol-narxlari-tariflari-kuzatuvini-tashkil-etish-hamda-iste-mol-narxlari-indeksini-hisoblash-bo-yicha-uslubiy-nizom", "value_ru": "https://lib.stat.uz/ru/features-3/tseny/654-tovarlar-va-xizmatlarning-iste-mol-narxlari-tariflari-kuzatuvini-tashkil-etish-hamda-iste-mol-narxlari-indeksini-hisoblash-bo-yicha-uslubiy-nizom-2", "value_en": "https://lib.stat.uz/ru/features-3/tseny/654-tovarlar-va-xizmatlarning-iste-mol-narxlari-tariflari-kuzatuvini-tashkil-etish-hamda-iste-mol-narxlari-indeksini-hisoblash-bo-yicha-uslubiy-nizom-2", "value_uzc": "https://lib.stat.uz/uz/features/narxlar/653-tovarlar-va-xizmatlarning-iste-mol-narxlari-tariflari-kuzatuvini-tashkil-etish-hamda-iste-mol-narxlari-indeksini-hisoblash-bo-yicha-uslubiy-nizom"}, {"name_uz": "Rasmiy statistika tayyorlovchi", "name_ru": "\u0421\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044c \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438", "name_en": "Official statistics preparer", "name_uzc": "\u0420\u0430\u0441\u043c\u0438\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0442\u0430\u0439\u0451\u0440\u043b\u043e\u0432\u0447\u0438", "value_uz": "O\u2018zbekiston Respublikasi Milliy Statistika qo'mitasi", "value_ru": "\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u043e\u043c\u0438\u0442\u0435\u0442 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u0423\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u0430\u043d \u043f\u043e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0435", "value_en": "National Statistical Committee of the Republic of Uzbekistan", "value_uzc": "\u040e\u0437\u0431\u0435\u043a\u0438\u0441\u0442\u043e\u043d \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0441\u0438 \u041c\u0438\u043b\u043b\u0438\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u049b\u045e\u043c\u0438\u0442\u0430\u0441\u0438"}, {"name_uz": "Mas\u2019ul boshqarma nomi", "name_ru": "\u041e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435", "name_en": "Name of department", "name_uzc": "\u041c\u0430\u0441\u044a\u0443\u043b \u0431\u043e\u0448\u049b\u0430\u0440\u043c\u0430 \u043d\u043e\u043c\u0438", "value_uz": "Narxlar statistikasi boshqarmasi", "value_ru": "\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438 \u0446\u0435\u043d", "value_en": "Department of Price Statistics", "value_uzc": "\u041d\u0430\u0440\u0445\u043b\u0430\u0440 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430\u0441\u0438 \u0431\u043e\u0448\u049b\u0430\u0440\u043c\u0430\u0441\u0438"}, {"name_uz": "Mas\u2019ul hodim FIO", "name_ru": "O\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a \u0424\u0418\u041e", "name_en": "Responsible officer name", "name_uzc": "\u041c\u0430\u0441\u044a\u0443\u043b \u04b3\u043e\u0434\u0438\u043c \u0424\u0418\u041e", "value_uz": "To'ychiyev Azizjon Ro'ziboy o'g'li", "value_ru": "\u0422\u0443\u0439\u0447\u0438\u0435\u0432 \u0410\u0437\u0438\u0437\u0436\u043e\u043d \u0420\u0443\u0437\u0438\u0431\u043e\u0439 \u0443\u0433\u043b\u0438", "value_en": "Tuychiev Azizjon Ruziboy ugli", "value_uzc": "\u0422\u0443\u0439\u0447\u0438\u0435\u0432 \u0410\u0437\u0438\u0437\u0436\u043e\u043d \u0420\u0443\u0437\u0438\u0431\u043e\u0439 \u0443\u0433\u043b\u0438"}, {"name_uz": "Telefon raqami :", "name_ru": "\u041d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 :", "name_en": "Phone number :", "name_uzc": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u0440\u0430\u049b\u0430\u043c\u0438 :", "value_uz": "+99871 202 80 00 (1113)", "value_ru": "+99871 202 80 00 (1113)", "value_en": "+99871 202 80 00 (1113)", "value_uzc": "+99871 203 80 00"}, {"name_uz": "Elektron pochta", "name_ru": "\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0430\u044f \u043f\u043e\u0447\u0442\u0430", "name_en": "Email", "name_uzc": "\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d \u043f\u043e\u0447\u0442\u0430", "value_uz": "sh.ismailova@stat.uz", "value_ru": "sh.ismailova@stat.uz", "value_en": "sh.ismailova@stat.uz", "value_uzc": "sh.ismailova@stat.uz"}, {"name_uz": "Birlamchi ma\u2019lumot manbasi", "name_ru": "\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438", "name_en": "Primary source of information", "name_uzc": "\u0411\u0438\u0440\u043b\u0430\u043c\u0447\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442 \u043c\u0430\u043d\u0431\u0430\u0441\u0438", "value_uz": "Hisob-kitoblarda quyidagi manbalardan olingan narxlar o\u2018zgarishi haqidagi ma\u2019lumotlar qo\u2018llaniladi:\n(1) CAPI texnologiyasiga asoslangan ma\u2019lumotlar (chakana savdo do\u2018konlariga tashrif buyurib, narxlarni ro\u2018yxatdan o\u2018tkazish);\n(2) ma\u2019muriy tranzaksion ma\u2019lumotlar (soliq organlari ma\u2019lumotlar bazasidan olingan onlayn-kassa mashinalari cheklari haqidagi ma\u2019lumotlar);\n(3) eStat tizimi orqali xizmat ko\u2018rsatuvchi provayderlar va chakana sotuvchilardan olingan ma\u2019lumotlar (API/Excel formatida);\n(4) web scraping texnologiyasiga asoslangan hamda turli xil onlayn manbalardan (veb-sayt ma\u2019lumotlaridan) olingan narxlar;\n(5) CATI texnologiyasiga asoslangan ma\u2019lumotlar (telefon orqali so\u2018rovnomalar).", "value_ru": "\u0412 \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e\u0431 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u0446\u0435\u043d, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u0430\u044f \u0438\u0437 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432: \n(1) \u0434\u0430\u043d\u043d\u044b\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 CAPI (\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0446\u0435\u043d \u0441 \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u0435\u043c \u0442\u043e\u0440\u0433\u043e\u0432\u044b\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432); \n(2) \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 (\u043f\u043e \u043e\u043d\u043b\u0430\u0439\u043d-\u043a\u0430\u0441\u0441\u043e\u0432\u044b\u043c \u0447\u0435\u043a\u0430\u043c \n\u0438\u0437 \u0431\u0430\u0437\u044b \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0445 \u043e\u0440\u0433\u0430\u043d\u043e\u0432); \n(3) \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e\u0442 \u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a\u043e\u0432 \u0443\u0441\u043b\u0443\u0433 \u0447\u0435\u0440\u0435\u0437 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 eStat\u0438 \u043e\u0442 \u0440\u0438\u0442\u0435\u0439\u043b\u0435\u0440\u043e\u0432 (\u0432 \u0444\u043e\u0440\u043c\u0430\u0442\u0435 API/Excel); \n(4) \u0446\u0435\u043d\u044b \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 web scraping \u0438 \u0438\u0437 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043e\u043d\u043b\u0430\u0439\u043d-\u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432 (\u0434\u0430\u043d\u043d\u044b\u0435 \u0441\u0430\u0439\u0442\u043e\u0432); \n(5) \u0434\u0430\u043d\u043d\u044b\u0435 \u043d\u0430 \u0431\u0430\u0437\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 CATI (\u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u0435 \u043e\u043f\u0440\u043e\u0441\u044b).", "value_en": "Information on price changes used in the calculations is obtained from the following sources:\n1.\tdata collected using computer-assisted personal interviewing (CAPI), involving in-person price collection at retail and service outlets;\n2.\tadministrative transaction data based on online cash-register receipts obtained from the tax authorities\u2019 database;\n3.\tdata submitted by service providers through the eStat system and by retailers in API or Excel format;\n4.\tprices collected using web-scraping technology and from various online sources, including website data;\n5.\tdata collected using computer-assisted telephone interviewing (CATI).", "value_uzc": "\u04b2\u0438\u0441\u043e\u0431-\u043a\u0438\u0442\u043e\u0431\u043b\u0430\u0440\u0434\u0430 \u049b\u0443\u0439\u0438\u0434\u0430\u0433\u0438 \u043c\u0430\u043d\u0431\u0430\u043b\u0430\u0440\u0434\u0430\u043d \u043e\u043b\u0438\u043d\u0433\u0430\u043d \u043d\u0430\u0440\u0445\u043b\u0430\u0440 \u045e\u0437\u0433\u0430\u0440\u0438\u0448\u0438 \u04b3\u0430\u049b\u0438\u0434\u0430\u0433\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u049b\u045e\u043b\u043b\u0430\u043d\u0438\u043b\u0430\u0434\u0438: (1) CAPI \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u0441\u0438\u0433\u0430 \u0430\u0441\u043e\u0441\u043b\u0430\u043d\u0433\u0430\u043d \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 (\u0447\u0430\u043a\u0430\u043d\u0430 \u0441\u0430\u0432\u0434\u043e \u0434\u045e\u043a\u043e\u043d\u043b\u0430\u0440\u0438\u0433\u0430 \u0442\u0430\u0448\u0440\u0438\u0444 \u0431\u0443\u044e\u0440\u0438\u0431, \u043d\u0430\u0440\u0445\u043b\u0430\u0440\u043d\u0438 \u0440\u045e\u0439\u0445\u0430\u0442\u0434\u0430\u043d \u045e\u0442\u043a\u0430\u0437\u0438\u0448); (2) \u043c\u0430\u044a\u043c\u0443\u0440\u0438\u0439 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0441\u0438\u043e\u043d \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 (\u0441\u043e\u043b\u0438\u049b \u043e\u0440\u0433\u0430\u043d\u043b\u0430\u0440\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u0431\u0430\u0437\u0430\u0441\u0438\u0434\u0430\u043d \u043e\u043b\u0438\u043d\u0433\u0430\u043d \u043e\u043d\u043b\u0430\u0439\u043d-\u043a\u0430\u0441\u0441\u0430 \u043c\u0430\u0448\u0438\u043d\u0430\u043b\u0430\u0440\u0438 \u0447\u0435\u043a\u043b\u0430\u0440\u0438 \u04b3\u0430\u049b\u0438\u0434\u0430\u0433\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440); (3) eStat \u0442\u0438\u0437\u0438\u043c\u0438 \u043e\u0440\u049b\u0430\u043b\u0438 \u0445\u0438\u0437\u043c\u0430\u0442 \u043a\u045e\u0440\u0441\u0430\u0442\u0443\u0432\u0447\u0438 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u043b\u0430\u0440 \u0432\u0430 \u0447\u0430\u043a\u0430\u043d\u0430 \u0441\u043e\u0442\u0443\u0432\u0447\u0438\u043b\u0430\u0440\u0434\u0430\u043d \u043e\u043b\u0438\u043d\u0433\u0430\u043d \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 (\u0410PI/Excel \u0444\u043e\u0440\u043c\u0430\u0442\u0438\u0434\u0430); (4) web scraping \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u0441\u0438\u0433\u0430 \u0430\u0441\u043e\u0441\u043b\u0430\u043d\u0433\u0430\u043d \u04b3\u0430\u043c\u0434\u0430 \u0442\u0443\u0440\u043b\u0438 \u0445\u0438\u043b \u043e\u043d\u043b\u0430\u0439\u043d \u043c\u0430\u043d\u0431\u0430\u043b\u0430\u0440\u0434\u0430\u043d (\u0432\u0435\u0431-\u0441\u0430\u0439\u0442 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440\u0438\u0434\u0430\u043d) \u043e\u043b\u0438\u043d\u0433\u0430\u043d \u043d\u0430\u0440\u0445\u043b\u0430\u0440; (5) CATI \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u0441\u0438\u0433\u0430 \u0430\u0441\u043e\u0441\u043b\u0430\u043d\u0433\u0430\u043d \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 (\u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043e\u0440\u049b\u0430\u043b\u0438 \u0441\u045e\u0440\u043e\u0432\u043d\u043e\u043c\u0430\u043b\u0430\u0440)."}, {"name_uz": "Hisoblash usullari (qisqacha)", "name_ru": "\u041c\u0435\u0442\u043e\u0434\u044b \u0440\u0430\u0441\u0447\u0435\u0442\u0430 (\u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u043e)", "name_en": "Brief description of calculation methods", "name_uzc": "\u04b2\u0438\u0441\u043e\u0431\u043b\u0430\u0448 \u0443\u0441\u0443\u043b\u043b\u0430\u0440\u0438 (\u049b\u0438\u0441\u049b\u0430\u0447\u0430)", "value_uz": "2026-yil yanvaridan boshlab Iste\u2019mol narxlari indeksining oylik hisob-kitobi 517 ta tovar va xizmat turiga (2025-yilda \u2014 510 ta) asoslanadi, shundan 419 tasi tovar va 98 tasi xizmatlardir.\nNarxlarni yig\u2018ish har oyning 1-sanasidan 25-sanasigacha bo\u2018lgan davrda amalga oshiriladi.\nINI o\u2018zgartirilgan Yang arifmetik formulasi yordamida hisoblanadi.\nINI hisob-kitoblari:\n(1) salmoq vaznlarini shakllantirishga xizmat qiladigan aholi xarajatlarining tuzilmasi to\u2018g\u2018risidagi ma\u2019lumotlar (uy xo\u2018jaliklari tanlanma kuzatuvi ma\u2019lumotlari);\n(2) iste\u2019mol narxlarining o\u2018zgarishi to\u2018g\u2018risidagi ma\u2019lumotlar asosida amalga oshiriladi.\nNarxlar to\u2018g\u2018risidagi ma\u2019lumotlar hududlarning ijtimoiy-iqtisodiy va geografik holatini aks ettirishi hamda iste\u2019mol bozorining tovarlar va xizmatlar bilan to\u2018yinganlik darajasini hisobga olgan holda tanlab olingan Nukus shahri, Toshkent shahri, viloyatlar markazlari, shuningdek, tanlanma asosida shaharlar va tumanlar markazlaridan to\u2018planadi.\nTovarlar va xizmatlar narxlari hamda tariflari kuzatuvi turg\u2018un savdo va xizmat ko\u2018rsatish sohasi shoxobchalarida, shuningdek, ko\u2018chma savdo obyektlarida (palatkalar, rastalar va boshqalar) tanlanma asosida o\u2018tkaziladi.", "value_ru": "\u0415\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0439 \u0440\u0430\u0441\u0447\u0435\u0442 \u0418\u041f\u0426 \u0441 \u044f\u043d\u0432\u0430\u0440\u044f 2026 \u0433\u043e\u0434\u0430 \u043e\u0441\u043d\u043e\u0432\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 517 \u043f\u043e\u0437\u0438\u0446\u0438\u044f\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0438 \u0443\u0441\u043b\u0443\u0433 (\u0432 2025 \u0433\u043e\u0434\u0443 \u2014 510 \u043f\u043e\u0437\u0438\u0446\u0438\u0439), \u0432\u043a\u043b\u044e\u0447\u0430\u044f 419 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0438 98 \u0443\u0441\u043b\u0443\u0433.\n\u0421\u0431\u043e\u0440 \u0446\u0435\u043d \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u043f\u0440\u043e\u0442\u044f\u0436\u0435\u043d\u0438\u0438 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0441 1-\u0433\u043e \u043f\u043e 25-\u0435 \u0447\u0438\u0441\u043b\u043e \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043c\u0435\u0441\u044f\u0446\u0430. \n\u0420\u0430\u0441\u0447\u0435\u0442 \u0418\u041f\u0426 \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043c\u043e\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0444\u043e\u0440\u043c\u0443\u043b\u044b \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u042f\u043d\u0433\u0430.\n\u0420\u0430\u0441\u0447\u0435\u0442 \u0418\u041f\u0426 \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430 \u0431\u0430\u0437\u0435 (1) \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435 \u0440\u0430\u0441\u0445\u043e\u0434\u043e\u0432 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f (\u0434\u0430\u043d\u043d\u044b\u0435 \u0432\u044b\u0431\u043e\u0440\u043e\u0447\u043d\u044b\u0445 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439 \u0434\u043e\u043c\u0430\u0448\u043d\u0438\u0445 \u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432), \u0441\u043b\u0443\u0436\u0430\u0449\u0438\u0445 \u043e\u0441\u043d\u043e\u0432\u043e\u0439 \u0434\u043b\u044f \u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0443\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0432\u0435\u0441\u043e\u0432, \u0438 (2) \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043e\u0431 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445 \u0446\u0435\u043d. \n\u0426\u0435\u043d\u043e\u0432\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0441\u043e\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044f \u0432 \u0433. \u041d\u0443\u043a\u0443\u0441\u0435, \u0433. \u0422\u0430\u0448\u043a\u0435\u043d\u0442\u0435, \u043e\u0431\u043b\u0430\u0441\u0442\u043d\u044b\u0445 \u0446\u0435\u043d\u0442\u0440\u0430\u0445 \u0438 \u0432\u044b\u0431\u043e\u0440\u043e\u0447\u043d\u043e \u0432 \u0433\u043e\u0440\u043e\u0434\u0430\u0445 \u0438 \u0440\u0430\u0439\u043e\u043d\u043d\u044b\u0445 \u0446\u0435\u043d\u0442\u0440\u0430\u0445, \u043e\u0442\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0445 \u0441 \u0443\u0447\u0435\u0442\u043e\u043c \u0438\u0445 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432 \u043e\u0442\u0440\u0430\u0436\u0435\u043d\u0438\u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e-\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e, \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0440\u0435\u0433\u0438\u043e\u043d\u043e\u0432 \u0438 \u0443\u0440\u043e\u0432\u043d\u044f \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0433\u043e \u0440\u044b\u043d\u043a\u0430 \u0442\u043e\u0432\u0430\u0440\u0430\u043c\u0438 \u0438 \u0443\u0441\u043b\u0443\u0433\u0430\u043c\u0438. \n\u041d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0437\u0430 \u0446\u0435\u043d\u0430\u043c\u0438 \u0438 \u0442\u0430\u0440\u0438\u0444\u0430\u043c\u0438 \u043d\u0430 \u0442\u043e\u0432\u0430\u0440\u044b \u0438 \u0443\u0441\u043b\u0443\u0433\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0432\u044b\u0431\u043e\u0440\u043e\u0447\u043d\u043e \u043a\u0430\u043a \u0432 \u0441\u0442\u0430\u0446\u0438\u043e\u043d\u0430\u0440\u043d\u044b\u0445 \u043e\u0431\u044a\u0435\u043a\u0442\u0430\u0445 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0438 \u0438 \u0441\u0444\u0435\u0440\u044b \u0443\u0441\u043b\u0443\u0433, \u0442\u0430\u043a \u0438 \u0432 \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u043d\u043e\u0439 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435 (\u043f\u0430\u043b\u0430\u0442\u043a\u0438, \u043a\u0438\u043e\u0441\u043a\u0438 \u0438 \u0442. \u0434.). \n\u0414\u043b\u044f \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0446\u0435\u043d \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043c\u0435\u0442\u043e\u0434\u044b \u0443\u0441\u043b\u043e\u0432\u043d\u044b\u0445 \u0440\u0430\u0441\u0447\u0435\u0442\u043e\u0432 (\u0438\u043c\u043f\u0443\u0442\u0430\u0446\u0438\u044f, \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u043d\u0430 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430).", "value_en": "Since January 2026, the monthly Consumer Price Index (CPI) has been compiled on the basis of 517 representative goods and services, compared with 510 items in 2025. The 2026 basket comprises 419 goods and 98 services.\nPrices are collected from the 1st to the 25th day of each month.\nThe CPI is calculated using the modified arithmetic Young index formula.\nThe CPI calculation is based on:\n1.\tinformation on the structure of household expenditure, obtained from household sample surveys and used to derive the expenditure weights; and\n2.\tinformation on changes in consumer prices.\nPrice data are collected in Nukus, Tashkent, regional administrative centres and selected cities and district centres. These locations are selected on the basis of their representativeness in terms of the socioeconomic and geographical characteristics of the regions and the level of availability of goods and services in the consumer market.\nPrices and tariffs for goods and services are observed on a sample basis both at fixed retail and service outlets and at non-fixed retail outlets, such as market stalls, kiosks and similar facilities.\nWhere prices are unavailable, estimation methods are applied, including imputation and adjustments for changes in quality.", "value_uzc": "2026 \u0439\u0438\u043b \u044f\u043d\u0432\u0430\u0440\u0438\u0434\u0430\u043d \u0431\u043e\u0448\u043b\u0430\u0431 \u0418\u0441\u0442\u0435\u044a\u043c\u043e\u043b \u043d\u0430\u0440\u0445\u043b\u0430\u0440\u0438 \u0438\u043d\u0434\u0435\u043a\u0441\u0438\u043d\u0438\u043d\u0433 \u043e\u0439\u043b\u0438\u043a \u04b3\u0438\u0441\u043e\u0431-\u043a\u0438\u0442\u043e\u0431\u0438 517 \u0442\u0430 \u0442\u043e\u0432\u0430\u0440 \u0432\u0430 \u0445\u0438\u0437\u043c\u0430\u0442 \u0442\u0443\u0440\u0438\u0433\u0430 (2025 \u0439\u0438\u043b\u0434\u0430 \u2014 510 \u0442\u0430) \u0430\u0441\u043e\u0441\u043b\u0430\u043d\u0430\u0434\u0438, \u0448\u0443\u043d\u0434\u0430\u043d 419 \u0442\u0430\u0441\u0438 \u0442\u043e\u0432\u0430\u0440 \u0432\u0430 98 \u0442\u0430\u0441\u0438 \u0445\u0438\u0437\u043c\u0430\u0442\u043b\u0430\u0440\u0434\u0438\u0440. \u041d\u0430\u0440\u0445\u043b\u0430\u0440\u043d\u0438 \u0439\u0438\u0493\u0438\u0448 \u04b3\u0430\u0440 \u043e\u0439\u043d\u0438\u043d\u0433 1-\u0441\u0430\u043d\u0430\u0441\u0438\u0434\u0430\u043d 25-\u0441\u0430\u043d\u0430\u0441\u0438\u0433\u0430\u0447\u0430 \u0431\u045e\u043b\u0433\u0430\u043d \u0434\u0430\u0432\u0440\u0434\u0430 \u0430\u043c\u0430\u043b\u0433\u0430 \u043e\u0448\u0438\u0440\u0438\u043b\u0430\u0434\u0438. \u0418\u041d\u0418 \u045e\u0437\u0433\u0430\u0440\u0442\u0438\u0440\u0438\u043b\u0433\u0430\u043d \u042f\u043d\u0433 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u043a \u0444\u043e\u0440\u043c\u0443\u043b\u0430\u0441\u0438 \u0451\u0440\u0434\u0430\u043c\u0438\u0434\u0430 \u04b3\u0438\u0441\u043e\u0431\u043b\u0430\u043d\u0430\u0434\u0438. \u0418\u041d\u0418 \u04b3\u0438\u0441\u043e\u0431-\u043a\u0438\u0442\u043e\u0431\u043b\u0430\u0440\u0438: (1) \u0441\u0430\u043b\u043c\u043e\u049b \u0432\u0430\u0437\u043d\u043b\u0430\u0440\u0438\u043d\u0438 \u0448\u0430\u043a\u043b\u043b\u0430\u043d\u0442\u0438\u0440\u0438\u0448\u0433\u0430 \u0445\u0438\u0437\u043c\u0430\u0442 \u049b\u0438\u043b\u0430\u0434\u0438\u0433\u0430\u043d \u0430\u04b3\u043e\u043b\u0438 \u0445\u0430\u0440\u0430\u0436\u0430\u0442\u043b\u0430\u0440\u0438\u043d\u0438\u043d\u0433 \u0442\u0443\u0437\u0438\u043b\u043c\u0430\u0441\u0438 \u0442\u045e\u0493\u0440\u0438\u0441\u0438\u0434\u0430\u0433\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 (\u0443\u0439 \u0445\u045e\u0436\u0430\u043b\u0438\u043a\u043b\u0430\u0440\u0438 \u0442\u0430\u043d\u043b\u0430\u043d\u043c\u0430 \u043a\u0443\u0437\u0430\u0442\u0443\u0432\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440\u0438); (2) \u0438\u0441\u0442\u0435\u044a\u043c\u043e\u043b \u043d\u0430\u0440\u0445\u043b\u0430\u0440\u0438\u043d\u0438\u043d\u0433 \u045e\u0437\u0433\u0430\u0440\u0438\u0448\u0438 \u0442\u045e\u0493\u0440\u0438\u0441\u0438\u0434\u0430\u0433\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u0430\u0441\u043e\u0441\u0438\u0434\u0430 \u0430\u043c\u0430\u043b\u0433\u0430 \u043e\u0448\u0438\u0440\u0438\u043b\u0430\u0434\u0438. \u041d\u0430\u0440\u0445\u043b\u0430\u0440 \u0442\u045e\u0493\u0440\u0438\u0441\u0438\u0434\u0430\u0433\u0438 \u043c\u0430\u044a\u043b\u0443\u043c\u043e\u0442\u043b\u0430\u0440 \u04b3\u0443\u0434\u0443\u0434\u043b\u0430\u0440\u043d\u0438\u043d\u0433 \u0438\u0436\u0442\u0438\u043c\u043e\u0438\u0439-\u0438\u049b\u0442\u0438\u0441\u043e\u0434\u0438\u0439 \u0432\u0430 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0438\u043a \u04b3\u043e\u043b\u0430\u0442\u0438\u043d\u0438 \u0430\u043a\u0441 \u044d\u0442\u0442\u0438\u0440\u0438\u0448\u0438 \u04b3\u0430\u043c\u0434\u0430 \u0438\u0441\u0442\u0435\u044a\u043c\u043e\u043b \u0431\u043e\u0437\u043e\u0440\u0438\u043d\u0438\u043d\u0433 \u0442\u043e\u0432\u0430\u0440\u043b\u0430\u0440 \u0432\u0430 \u0445\u0438\u0437\u043c\u0430\u0442\u043b\u0430\u0440 \u0431\u0438\u043b\u0430\u043d \u0442\u045e\u0439\u0438\u043d\u0433\u0430\u043d\u043b\u0438\u043a \u0434\u0430\u0440\u0430\u0436\u0430\u0441\u0438\u043d\u0438 \u04b3\u0438\u0441\u043e\u0431\u0433\u0430 \u043e\u043b\u0433\u0430\u043d \u04b3\u043e\u043b\u0434\u0430 \u0442\u0430\u043d\u043b\u0430\u0431 \u043e\u043b\u0438\u043d\u0433\u0430\u043d \u041d\u0443\u043a\u0443\u0441 \u0448\u0430\u04b3\u0440\u0438, \u0422\u043e\u0448\u043a\u0435\u043d\u0442 \u0448\u0430\u04b3\u0440\u0438, \u0432\u0438\u043b\u043e\u044f\u0442\u043b\u0430\u0440 \u043c\u0430\u0440\u043a\u0430\u0437\u043b\u0430\u0440\u0438, \u0448\u0443\u043d\u0438\u043d\u0433\u0434\u0435\u043a, \u0442\u0430\u043d\u043b\u0430\u043d\u043c\u0430 \u0430\u0441\u043e\u0441\u0438\u0434\u0430 \u0448\u0430\u04b3\u0430\u0440\u043b\u0430\u0440 \u0432\u0430 \u0442\u0443\u043c\u0430\u043d\u043b\u0430\u0440 \u043c\u0430\u0440\u043a\u0430\u0437\u043b\u0430\u0440\u0438\u0434\u0430\u043d \u0442\u045e\u043f\u043b\u0430\u043d\u0430\u0434\u0438. \u0422\u043e\u0432\u0430\u0440\u043b\u0430\u0440 \u0432\u0430 \u0445\u0438\u0437\u043c\u0430\u0442\u043b\u0430\u0440 \u043d\u0430\u0440\u0445\u043b\u0430\u0440\u0438 \u04b3\u0430\u043c\u0434\u0430 \u0442\u0430\u0440\u0438\u0444\u043b\u0430\u0440\u0438 \u043a\u0443\u0437\u0430\u0442\u0443\u0432\u0438 \u0442\u0443\u0440\u0493\u0443\u043d \u0441\u0430\u0432\u0434\u043e \u0432\u0430 \u0445\u0438\u0437\u043c\u0430\u0442 \u043a\u045e\u0440\u0441\u0430\u0442\u0438\u0448 \u0441\u043e\u04b3\u0430\u0441\u0438 \u0448\u043e\u0445\u043e\u0431\u0447\u0430\u043b\u0430\u0440\u0438\u0434\u0430, \u0448\u0443\u043d\u0438\u043d\u0433\u0434\u0435\u043a, \u043a\u045e\u0447\u043c\u0430 \u0441\u0430\u0432\u0434\u043e \u043e\u0431\u044a\u0435\u043a\u0442\u043b\u0430\u0440\u0438\u0434\u0430 (\u043f\u0430\u043b\u0430\u0442\u043a\u0430\u043b\u0430\u0440, \u0440\u0430\u0441\u0442\u0430\u043b\u0430\u0440 \u0432\u0430 \u0431\u043e\u0448\u049b\u0430\u043b\u0430\u0440) \u0442\u0430\u043d\u043b\u0430\u043d\u043c\u0430 \u0430\u0441\u043e\u0441\u0438\u0434\u0430 \u045e\u0442\u043a\u0430\u0437\u0438\u043b\u0430\u0434\u0438."}, {"name_uz": "Izoh", "name_ru": "\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435", "name_en": "Note", "name_uzc": "\u0418\u0437\u043e\u04b3", "value_uz": "2021- yil yanvar oyidan boshlab INI Maqsadlar bo\u2018yicha individual iste\u2019mol tasniflagichi-2018 bo\u2018yicha hisoblangan. 2026-yilgacha hisob-kitoblarda Laspeyres (Lou)ning modifikatsiya qilingan formulasi qo\u2018llanilgan. 2026-yildan boshlab arifmetik Yangning modifikatsiya qilingan formulasi qo\u2018llanilmoqda.", "value_ru": "\u0441 \u044f\u043d\u0432\u0430\u0440\u044f 2021 \u0433\u043e\u0434\u0430 \u0418\u041f\u0426 \u0440\u0430\u0441\u0447\u044b\u0442\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e \u041a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u0443 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u044f \u043f\u043e \u0446\u0435\u043b\u044f\u043c-2018. \u0414\u043e 2026 \u0433\u043e\u0434\u0430 \u0432 \u0440\u0430\u0441\u0447\u0435\u0442\u0430\u0445 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u043b\u0430\u0441\u044c \u043c\u043e\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u041b\u0430\u0441\u043f\u0435\u0439\u0440\u0435\u0441\u0430 (\u041b\u043e\u0443). \u0421 2026 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043c\u043e\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0444\u043e\u0440\u043c\u0443\u043b\u0430 \u0430\u0440\u0438\u0444\u043c\u0435\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u042f\u043d\u0433\u0430.", "value_en": "Since January 2021, the CPI is calculated according to the Classification of Individual Consumption According to Purposes-2018. Before 2026, the CPI was calculated using the modified Laspeyres (Lowe) index formula. Since 2026, the modified arithmetic Young index formula has been used.", "value_uzc": "2021- \u0439\u0438\u043b \u044f\u043d\u0432\u0430\u0440\u044c \u043e\u0439\u0438\u0434\u0430\u043d \u0431\u043e\u0448\u043b\u0430\u0431 \u0418\u041d\u0418 \u041c\u0430\u049b\u0441\u0430\u0434\u043b\u0430\u0440 \u0431\u045e\u0439\u0438\u0447\u0430 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b \u0438\u0441\u0442\u0435\u044a\u043c\u043e\u043b \u0442\u0430\u0441\u043d\u0438\u0444\u043b\u0430\u0433\u0438\u0447\u0438-2018 \u0431\u045e\u0439\u0438\u0447\u0430 \u04b3\u0438\u0441\u043e\u0431\u043b\u0430\u043d\u0433\u0430\u043d. 2026 \u0439\u0438\u043b\u0433\u0430\u0447\u0430 \u04b3\u0438\u0441\u043e\u0431-\u043a\u0438\u0442\u043e\u0431\u043b\u0430\u0440\u0434\u0430 \u041b\u0430\u0441\u043f\u0435\u0439\u0440\u0435\u0